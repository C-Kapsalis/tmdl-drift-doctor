table 'f-Filters'
	lineageTag: 7a1e0000-0000-4000-8000-000000000314

	measure 'f-Ads' = int(not ISEMPTY('Ads'))
		lineageTag: 7a1e0000-0000-4000-8000-000000000315

	measure 'f-Email' = 1
		lineageTag: 7a1e0000-0000-4000-8000-000000000316

	measure 'f-Loyalty' = 1
		lineageTag: 7a1e0000-0000-4000-8000-000000000317

	measure 'f-All' = [f-Ads] * [f-Email] * [f-Loyalty]
		lineageTag: 7a1e0000-0000-4000-8000-000000000318

	partition 'f-Filters' = m
		mode: import
		source =
				let
				    Source = #table({"id"}, {})
				in
				    Source

