table 'f-Filters'
	lineageTag: 7a1e0000-0000-4000-8000-000000000309

	measure 'f-Ads' = int(not ISEMPTY('Ads'))
		lineageTag: 7a1e0000-0000-4000-8000-000000000310

	measure 'f-Email' = 1
		lineageTag: 7a1e0000-0000-4000-8000-000000000311

	measure 'f-Loyalty' = 1
		lineageTag: 7a1e0000-0000-4000-8000-000000000312

	measure 'f-All' = [f-Ads] * [f-Email] * [f-Loyalty]
		lineageTag: 7a1e0000-0000-4000-8000-000000000313

	partition 'f-Filters' = m
		mode: import
		source =
				let
				    Source = #table({"id"}, {})
				in
				    Source

