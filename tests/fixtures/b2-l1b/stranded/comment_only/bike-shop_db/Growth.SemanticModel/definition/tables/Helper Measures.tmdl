table 'Helper Measures'
	lineageTag: 7a1e0000-0000-4000-8000-000000000140

	measure 'Has Ads' = int(not ISEMPTY('Ads'))
		lineageTag: 7a1e0000-0000-4000-8000-000000000141

	measure 'Ad Signal' =
			VAR has_ads = int(not ISEMPTY('Ads'))
			-- + int(not ISEMPTY('Old Campaigns'))
			RETURN
			    [Clicks] + 0
		lineageTag: 7a1e0000-0000-4000-8000-000000000142

	partition 'Helper Measures' = m
		mode: import
		source =
				let
				    Source = #table({"id"}, {})
				in
				    Source

