model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 3

queryGroup Marketing

	annotation PBI_QueryGroupOrder = 4

queryGroup Measures

	annotation PBI_QueryGroupOrder = 1

queryGroup Calendars

	annotation PBI_QueryGroupOrder = 2

queryGroup 'v-Variables\Time Limit Variables'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["__Calendar","_Accounts","Ads","#Report Measures","f-Filters","x-Selector 1","y-Selector 1","v-fromdate","v-daysAgo","v-isRolling","v-rows_limit"]

ref table __Calendar
ref table _Accounts
ref table Ads
ref table '#Report Measures'
ref table f-Filters
ref table 'x-Selector 1'
ref table 'y-Selector 1'
